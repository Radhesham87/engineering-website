# ---- Backend environment ----
# Local dev uses SQLite by default. For production set a Postgres URL:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./dev.db

# CHANGE THIS to a long random string in production
JWT_SECRET=CHANGE_ME_super_secret_key_min_32_chars_long_please
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default admin (change before deploying!)
ADMIN_EMAIL=admin@engpredictor.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Administrator

# Comma-separated allowed frontend origins.
# This MUST also be set as an env var directly on your backend host
# (Render / Cloud Run / etc.) — editing this .env.example file alone
# has no effect on a deployed server.
# NOTE: real Netlify site is "engineering-websit" (no final "e").
FRONTEND_ORIGINS=http://localhost:3000,https://engineering-websit.netlify.app

# Unified engineering cutoff dataset (MH-CET + JEE-Main)
DATASET_PATH=data/engineering_cutoffs.csv.gz
